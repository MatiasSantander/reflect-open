{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflect",
  "identifier": "app.reflect.desktop.dev",
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Reflect",
        "width": 1300,
        "height": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.dev.plist",
      "files": {
        "embedded.provisionprofile": null
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/team-reflect/reflect-open/releases/download/updater-dev-noop/latest.json"
      ]
    }
  }
}
